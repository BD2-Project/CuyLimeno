# CuyLimeno carga este archivo automáticamente (dotenvy) desde `.env`,
# `../.env` o `server/.env`. Las variables ya exportadas al proceso mandan.
CUYLIMENO_SERVER_ADDR=127.0.0.1:3001
SOUPDB_HOST=127.0.0.1
SOUPDB_PORT=55432
# Timeout de cada operación contra el motor (el servidor reintenta conexiones
# ociosas con un ping antes de reutilizarlas).
SOUPDB_TIMEOUT_MS=10000
SOUPDB_POOL_SIZE=4
SOUPDB_INVERTED_STORAGE_ROOT=/app/data/plugins/inverted
CUYLIMENO_DATA_DIR=./data/cuylimeno
CUYLIMENO_MAX_UPLOAD_MB=50
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=120000

# Nota: el MOTOR SoupDB cierra conexiones ociosas tras `SOCKET_TIMEOUT`
# segundos (default 30). Al arrancar el contenedor se recomienda:
#   docker run -e SOCKET_TIMEOUT=300 ...
# El servidor es robusto igualmente (ping + descarte de conexiones muertas).
