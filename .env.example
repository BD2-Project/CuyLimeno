# Copia este archivo a `.env` y completa tu clave.
# `.env` está ignorado por git y por Docker: la clave nunca se versiona
# ni se incluye en las imágenes; solo se inyecta en el contenedor al ejecutar.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Puerto del frontend de la demo (http://localhost:8080)
CUYLIMENO_WEB_PORT=8080

# Puerto del inspector SQL opcional (perfil inspeccion).
# SOUPCHEF_WEB_PORT=3000
